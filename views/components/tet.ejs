<style>
  /* customizable tet-flower styling */
  .tet-flower {
    color: #fff;
    font-size: 1em;
    font-family: Arial, sans-serif;
    text-shadow: 0 0 1px cornflowerblue;
  }

  @-webkit-keyframes tet-flowers-fall {
    0% {
      top: -10%
    }
    100% {
      top: 100%
    }
  }

  @-webkit-keyframes tet-flowers-shake {
    0%,
    100% {
      -webkit-transform: translateX(0);
      transform: translateX(0)
    }
    50% {
      -webkit-transform: translateX(80px);
      transform: translateX(80px)
    }
  }

  @keyframes tet-flowers-fall {
    0% {
      top: -10%
    }
    100% {
      top: 100%
    }
  }

  @keyframes tet-flowers-shake {
    0%,
    100% {
      transform: translateX(0)
    }
    50% {
      transform: translateX(80px)
    }
  }

  .tet-flower {
    position: fixed;
    top: -10%;
    z-index: 9999;
    -webkit-user-select: none;
    -moz-user-select: none;
    -ms-user-select: none;
    user-select: none;
    cursor: default;
    -webkit-animation-name: tet-flowers-fall, tet-flowers-shake;
    -webkit-animation-duration: 10s, 3s;
    -webkit-animation-timing-function: linear, ease-in-out;
    -webkit-animation-iteration-count: infinite, infinite;
    -webkit-animation-play-state: running, running;
    animation-name: tet-flowers-fall, tet-flowers-shake;
    animation-duration: 10s, 3s;
    animation-timing-function: linear, ease-in-out;
    animation-iteration-count: infinite, infinite;
    animation-play-state: running, running;
    pointer-events: none;
  }
  .tet-flower img {
    width: 70%;
  }

  .tet-flower:nth-of-type(0) {
    left: 5%;
    -webkit-animation-delay: 0s, 0s;
    animation-delay: 0s, 0s
  }

  .tet-flower:nth-of-type(1) {
    left: 15%;
    -webkit-animation-delay: 2s, 2s;
    animation-delay: 2s, 2s;
  }

  .tet-flower:nth-of-type(2) {
    left: 25%;
    -webkit-animation-delay: 3s, .6s;
    animation-delay: 3s, .6s;
  }

  .tet-flower:nth-of-type(3) {
    left: 35%;
    -webkit-animation-delay: 5s, 3s;
    animation-delay: 5s, 3s;
  }

  .tet-flower:nth-of-type(4) {
    left: 45%;
    -webkit-animation-delay: 3s, 3s;
    animation-delay: 3s, 3s;
  }

  .tet-flower:nth-of-type(5) {
    left: 55%;
    -webkit-animation-delay: 6s, 2s;
    animation-delay: 6s, 2s;
  }

  .tet-flower:nth-of-type(6) {
    left: 65%;
    -webkit-animation-delay: 8s, 3s;
    animation-delay: 8s, 3s;
  }

  .tet-flower:nth-of-type(7) {
    left: 75%;
    -webkit-animation-delay: 3s, 4s;
    animation-delay: 3s, 4s
  }

  .tet-flower:nth-of-type(8) {
    left: 85%;
    -webkit-animation-delay: 0s, 2s;
    animation-delay: 0s, 2s
  }

  .tet-flower:nth-of-type(9) {
    left: 95%;
    -webkit-animation-delay: 1.5s, 3s;
    animation-delay: 1.5s, 3s
  }

  .tet-flower:nth-of-type(10) {
    left: 20%;
    -webkit-animation-delay: 0s, 2s;
    animation-delay: 0s, 2s
  }

  .tet-flower:nth-of-type(11) {
    left: 40%;
    -webkit-animation-delay: 2.5s, 4s;
    animation-delay: 2.5s, 4s
  }

  .tet-bg-footer {
    position:fixed;
    z-index:9999;
    bottom:-50px;
    left:0;
    width:100%;
    height:104px;
    background:url(/assets/images/tet_bg1.png) repeat-x bottom left;
    pointer-events: none;
  }
  .tet-icon-footer {
    position:fixed;
    z-index:9999;
    bottom:10px;
    left:20px;
    pointer-events: none;
  }
  .tet-image-left {
    position:fixed;
    z-index:9999;
    top:65px;
    right:0;
    pointer-events: none;
    width: 118px;
  }
  body.auth-page .tet-image-left {
    top:0 !important;
  }
  /*#kt_aside_menu {*/
  /*  padding-bottom: 50px;*/
  /*}*/
  /*#kt_wrapper {*/
  /*  padding-bottom: 30px;*/
  /*}*/
  @media (max-width: 1024px) {
    .tet-image-left {
      top: 50px
    }
  }
  @media (max-width: 600px) {
    .tet-flower img {
      width: 50%;
    }
    .tet-flower:nth-of-type(0) {
      left: 5%;
      -webkit-animation-delay: 0s, 0s;
      animation-delay: 0s, 0s
    }
    .tet-flower:nth-of-type(1) {
      left: 65%;
      -webkit-animation-delay: 2s, 1s;
      animation-delay: 2s, 1s
    }
    .tet-flower:nth-of-type(2) {
      left: 15%;
      -webkit-animation-delay: .5s, 5s;
      animation-delay: .5s, 5s
    }
    .tet-flower:nth-of-type(3) {
      left: 25%;
      -webkit-animation-delay: 2s, 4s;
      animation-delay: 2s, 4s
    }
    .tet-flower:nth-of-type(4) {
      left: 10%;
      -webkit-animation-delay: 4s, 2s;
      animation-delay: 4s, 2s
    }
    .tet-flower:nth-of-type(5) {
      left: 50%;
      -webkit-animation-delay: 3s, 8s;
      animation-delay: 3s, 8s
    }
    .tet-flower:nth-of-type(6) {
      left: 70%;
      -webkit-animation-delay: 2s, 6s;
      animation-delay: 2s, 6s
    }
    .tet-flower:nth-of-type(7) {
      left: 85%;
      -webkit-animation-delay: 1s, 2.5s;
      animation-delay: 1s, 2.5s
    }
    .tet-flower:nth-of-type(8) {
      left: 95%;
      -webkit-animation-delay: 0s, 1s;
      animation-delay: 0s, 1s
    }
    .tet-flower:nth-of-type(9),
    .tet-flower:nth-of-type(10),
    .tet-flower:nth-of-type(11) {
      display: none;
    }
    .tet-image-left {
      display: none;
    }
    .tet-bg-footer {
      height: 80px;
    }
    .tet-icon-footer {
      bottom:2px;
      height: 60px;
    }
  }
</style>

