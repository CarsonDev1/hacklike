<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Tạo yêu cầu
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_list" role="tab" aria-selected="false">
                <i class="fas fa-book-bookmark" aria-hidden="true"></i>Danh sách yêu cầu
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="<%= '/orders/create' %>">
                                <div class="form-group">
                                    <label>Chọn server</label>

                                    <div class="servers" id="servers"></div>
                                </div>

                                <div id="required_inputs"></div>

                                <div class="form-group">
                                    <label>SDT Zalo liên hệ</label>
                                    <input type="number" class="form-control" required name="data[contact_phone]"/>
                                </div>

                                <div class="form-group">
                                    <label>Giá dự kiến</label>
                                    <input type="text" class="form-control" id="total" disabled/>
                                </div>

                                <div class="form-group">
                                    <label>Ghi chú</label>
                                    <textarea class="form-control" name="note" rows="3"></textarea>
                                </div>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Tạo yêu cầu
                                    </button>

                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_history">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <% if (service_category?.data?.embed_video) { %>
                        <div class="card form-group">
                            <div class="card-header bg-primary text-white">
                                Video hướng dẫn
                            </div>
                            <div class="card-body embed-container">
                                <iframe
                                        width="560"
                                        height="315"
                                        src="https://www.youtube.com/embed/<%= service_category?.data?.embed_video %>"
                                        title="YouTube video player"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                        allowfullscreen
                                ></iframe>
                            </div>
                        </div>
                    <% } %>

                    <% if (service_category.data.show_note) { %>
                        <div class="card form-group">
                            <div class="card-header bg-primary text-white area-note">Lưu ý:</div>
                            <div class="card-body"><%- service_category.data?.main_note || '' %></div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="tab-pane" id="kt_list" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-orders"></table>
            </div>
        </div>

        <div class="tab-pane" id="kt_history" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-ajax"></table>
            </div>
        </div>
    </div>
</div>

<!--begin::Modal-->
<div class="modal fade" id="modalEditOrder" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form action="<%= '/orders/update' %>" method="post" class="form-json">
            <input type="hidden" name="id"/>

            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Sửa</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Thông tin cung cấp</label>
                        <textarea class="form-control" id="inputs" rows="6" readonly></textarea>
                    </div>

                    <div class="form-group">
                        <label>Ghi chú</label>
                        <textarea class="form-control" name="note" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                    <button class="btn btn-success" type="submit">Sửa</button>
                </div>
            </div>
        </form>
    </div>
</div>
<!--end::Modal-->

<script>
    const category_id = '<%= service_category.id %>';
    const type = '<%= site.type %>';
</script>

