<body
        class="kt-offcanvas-panel--right kt-header--fixed kt-header-mobile--fixed kt-subheader--fixed kt-subheader--enabled kt-subheader--solid auth-page">

<%- include('../components/theme.ejs') -%>

<!-- begin:: Page -->
<div class="kt-grid kt-grid--ver kt-grid--root">
    <div class="kt-grid kt-grid--hor kt-grid--root  kt-login kt-login--v4 kt-login--signin" id="kt_login">
        <div class="kt-grid__item kt-grid__item--fluid kt-grid kt-grid--hor has-background">

            <div class="kt-grid__item kt-grid__item--fluid kt-login__wrapper">
                <div class="kt-login__container">
                    <div class="kt-login__logo">
                        <a href="/">
                            <img src="/assets/images/logo.webp" width="200px" alt="">
                        </a>
                    </div>
                    <div class="kt-login__signin">
                        <form id="frmAuth" class="kt-form" action="<%= '/auth/register/' %>">
                            <div class="input-group">
                                <input class="form-control auto-lowercase" type="email"
                                       placeholder="Email của bạn (Dùng để khôi phục tài khoản)" name="email"
                                       autocomplete="off"
                                       required maxlength="100">
                            </div>
                            <div class="input-group">
                                <input class="form-control auto-lowercase" id="user_register" type="text"
                                       placeholder="Username của bạn" name="username"
                                       autocomplete="off" required maxlength="100">
                            </div>
                            <div class="input-group">
                                <input class="form-control" type="number" placeholder="SDT của bạn" name="phone"
                                       autocomplete="off" required>
                            </div>
                            <div class="input-group password-container">
                                <input class="form-control" id="password_register" type="password"
                                       placeholder="Mật khẩu" name="password" required>

                                <div class="check-password">
                                    <div>Yêu cầu về mật khẩu:</div>
                                    <div id="length_password" class="invalid check-password-item">
                                        Dài tối thiểu 8 ký tự.
                                    </div>

                                    <div id="character_password" class="invalid check-password-item">
                                        Bao gồm chữ, số và ký tự đặc biệt.
                                    </div>
                                    <div id="likeUser_password" class="invalid check-password-item">
                                        Không chứa tên đăng nhập.
                                    </div>

                                </div>
                            </div>
                            <div class="input-group">
                                <input class="form-control" id="re_password_register" type="password"
                                       placeholder="Nhập lại mật khẩu" name="confirm" required>
                                <div class="re-check-password">
                                    Nhập lại mật khẩu chưa khớp!
                                </div>
                            </div>

                            <div class="input-group">
                                <input class="form-control" placeholder="Mã giới thiệu (nếu có)" name="referral_code">
                            </div>

                            <div class="kt-login__actions">
                                <!--                  <div class="g-recaptcha"-->
                                <!--                       data-sitekey="6LfgQIMcAAAAAF3Bx2gmzHXwtAnATuw6dc_HBvMq"-->
                                <!--                       data-callback="onSubmit"-->
                                <!--                       data-size="invisible">-->
                                <!--                  </div>-->

                                <button type="submit" class="btn btn-brand btn-pill kt-login__btn-primary btn-submit">
                                    Đăng Ký
                                </button>
                            </div>

                        </form>
                    </div>
                    <div class="kt-login__account">
              <span class="kt-login__account-msg">
                Đã Có Tài Khoản ?
              </span>
                        &nbsp;&nbsp;
                        <a href="<%= '/login' %>" id="kt_login_signup" class="kt-login__account-link">Đăng Nhập!</a>
                    </div>

                    <% if (!googleBot) { %>
                        <%- include('./components/google_translate') %>
                    <% } %>

                </div>
            </div>
        </div>
    </div>
</div>

<!--begin:: Global Mandatory Vendors -->
<script src="/assets/plugins/jquery/jquery.min.js" type="text/javascript"></script>
<script src="/assets/plugins/sweetalert2/sweetalert2.min.js?v=<%= version %>" type="text/javascript"></script>
<script src="/assets/js/auth.js?v=<%= version %>" type="text/javascript"></script>

<%- // include('../components/fb_chat_widget.ejs')  %>
<%- include('./components/right_icons.ejs') %>

</body>

</html>