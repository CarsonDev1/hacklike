<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="/telegram/<%= site.type %>">
                                <div class="form-group">
                                    <label>Link Post kênh Telegram</label>
                                    <input type="text" class="form-control change-price" name="link"
                                           placeholder="https://t.me/sansisansale/366484" autocomplete="off"
                                           data-obj="telegram" required>

                                    <small class="mt-1">Vui lòng nhập link dạng: https://t.me/abc/1234</small>
                                    <p class="mt-1 text-danger">Chỉ hỗ trợ kênh, không hỗ trợ nhóm</p>
                                </div>

                                <div class="form-group">
                                    <label>Chọn server</label>

                                    <div class="servers">
                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_1">Server 1: Cảm xúc
                                                tích cực ngẫu nhiên [👍🤩🎉🔥❤️🥰👏🏻]
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_2">Server 2: Cảm xúc
                                                tiêu cực ngẫu nhiên [👎💩🤮😢😱]
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_3">Server 3: Cảm xúc
                                                tùy chỉnh
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_4">Server 4: Cảm xúc
                                                tùy chỉnh
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group server-section server_3-visible server_4-visible">
                                    <label>Loại Cảm xúc</label>
                                    <select class="form-control" name="reaction">
                                        <option value="reaction_1" class="server-section server_3-visible">Cảm xúc 👍
                                        </option>
                                        <option value="reaction_2" class="server-section server_3-visible">Cảm xúc 👎
                                        </option>
                                        <option value="reaction_3" class="server-section server_3-visible">Cảm xúc ❤️
                                        </option>
                                        <option value="reaction_4" class="server-section server_3-visible">Cảm xúc 💩
                                        </option>
                                        <option value="reaction_5" class="server-section server_3-visible">Cảm xúc 🔥
                                        </option>
                                        <option value="reaction_6" class="server-section server_3-visible">Cảm xúc 🤮
                                        </option>
                                        <option value="reaction_7" class="server-section server_3-visible">Cảm xúc 🎉
                                        </option>
                                        <option value="reaction_8" class="server-section server_3-visible">Cảm xúc 😢
                                        </option>
                                        <option value="reaction_9" class="server-section server_3-visible">Cảm xúc 🤩
                                        </option>
                                        <option value="reaction_10" class="server-section server_3-visible">Cảm xúc 😱
                                        </option>
                                        <option value="reaction_11" class="server-section server_3-visible">Cảm xúc 😁
                                        </option>

                                        <option value="reaction_7" class="server-section server_4-visible">Cảm xúc 🎉
                                        </option>
                                        <option value="reaction_9" class="server-section server_4-visible">Cảm xúc 🤩
                                        </option>
                                        <option value="reaction_5" class="server-section server_4-visible">Cảm xúc 🔥
                                        </option>
                                        <option value="reaction_2" class="server-section server_4-visible">Cảm xúc 👎
                                        </option>
                                        <option value="reaction_1" class="server-section server_4-visible">Cảm xúc 👍
                                        </option>
                                        <option value="reaction_10" class="server-section server_4-visible">Cảm xúc 😱
                                        </option>
                                        <option value="reaction_11" class="server-section server_4-visible">Cảm xúc 😁
                                        </option>
                                        <option value="reaction_8" class="server-section server_4-visible">Cảm xúc 😢
                                        </option>
                                        <option value="reaction_4" class="server-section server_4-visible">Cảm xúc 💩
                                        </option>
                                        <option value="reaction_6" class="server-section server_4-visible">Cảm xúc 🤮
                                        </option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="count">Số lượng</label>
                                    <input type="number" class="form-control" name="count" id="count" min="10"
                                           value="10"/>
                                </div>

                                <div class="form-group">
                                    <label for="price">Giá Tiền Mỗi Tương Tác</label>
                                    <input type="number" class="form-control" name="price" id="price" readonly/>
                                </div>

                                <%- include('../components/discount_widget.ejs') %>

                                <div class="form-group">
                                    <label for="total">Tổng Giá</label>
                                    <input type="text" class="form-control" name="total" id="total" disabled/>
                                </div>

                                <div class="form-group">
                                    <label for="note">Ghi chú</label>
                                    <textarea class="form-control" name="note" id="note" rows="1"></textarea>
                                </div>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Mua</button>
                                    -<span style="color:red">Đọc kĩ lưu ý Nếu bạn mua lỗi</span>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_history">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý ID
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <%- include('../components/note.ejs') %>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="kt_history" role="tabpanel">
            <%- include('../components/status_filter.ejs') %>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-ajax"></table>
            </div>
        </div>
    </div>
</div>
<script>
    var type = "<%= site.type %>";
</script>

