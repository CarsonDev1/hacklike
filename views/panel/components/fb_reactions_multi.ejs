<div class="fb-reaction m-t-10">
    <% ['like', 'love', 'care', 'wow', 'haha', 'sad', 'angry'].forEach(item => { %>
        <div class="checkbox">
            <label>
                <img src="/assets/images/fb-reaction/<%= item %>.png" alt="icon <%= item %>" class="img-responsive">
                <input name="reaction[]" value="<%= item %>"
                       type="checkbox" <%= ['like', 'love'].includes(item) ? 'checked' : '' %>>
            </label>
        </div>
    <% }) %>
</div>