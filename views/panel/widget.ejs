<div class="row">
    <div class="col-xl-12">
        <div class="kt-portlet kt-portlet--height-fluid">
            <div class="kt-portlet__body">
                <div class="kt-widget kt-widget--user-profile-3">
                    <div class="kt-widget__top">
                        <div class="kt-widget__media kt-hidden-">
                            <img src="/assets/images/admin.png" alt="image">
                        </div>
                        <div class="kt-widget__content">
                            <div class="kt-widget__head">
                                <a href="<%= '/profile/' %>" class="kt-widget__username">
                                    username
                                    <img class="icon-tick" src="/assets/images/tick.svg" alt=""/>
                                </a>
                            </div>

                            <div class="kt-widget__subhead">
                                <a href="javascript:void(0)" class="text-success"><i
                                            class="fas fa-envelope"></i>abc@gmail.com</a>
                                <a href="javascript:void(0)" class="text-primary"><i
                                            class="fas fa-user"></i>
                                    Quản trị viên
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="kt-widget__bottom currency-widget">
                        <div class="kt-widget__item">
                            <div class="kt-widget__icon">
                                <i class="fab fa-bitcoin text-success"></i>
                            </div>
                            <div class="kt-widget__details">
                                <span class="kt-widget__title">Số Dư</span>
                                <div class="kt-widget__value">

                                    <div class="dropdown currency-dropdown">
                                        <span class="dropdown-toggle" type="button" data-toggle="dropdown">
                                            <span class="money-value">100.000</span>
                                            <span class="tomato currency-unit">₫</span>
                                            <span class="fa fa-chevron-down"></span>
                                        </span>

                                        <div class="dropdown-menu">
                                            <div class="currency-item">
                                                <label>Chọn tiền tệ</label>

                                                <select class="form-control currency-select"></select>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                        <div class="kt-widget__item">
                            <div class="kt-widget__icon">
                                <i class="fas fa-chart-bar text-primary"></i>
                            </div>
                            <div class="kt-widget__details">
                                <span class="kt-widget__title">Đã Nạp</span>
                                <span class="kt-widget__value"><span></span>
                                    <span class="money-value" data-currency="vi">100.000</span>
                                    <span class="currency-unit tomato">₫</span>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>