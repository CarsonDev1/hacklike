<% layout("panel/layout") %>

<style>
    .rank-cards {
        display: flex;
        font-size: 16px;
    }

    .rank-card {
        border-radius: 5px;
        overflow: hidden;
        box-shadow: 0 4px 24px 0 rgba(34, 41, 47, 0.1);
        width: calc(25% - 15px);
        padding: 12px 15px 15px 15px;
        margin-left: 10px;
        margin-right: 10px;
        display: flex;
        flex-direction: column;
    }

    .rank-card:first-child {
        margin-left: 0;
    }

    .rank-card:last-child {
        margin-right: 0;
    }

    .rank-card-avatar {
        text-align: center;
        flex-shrink: 0;
    }

    .rank-card-avatar img {
        width: 110px;
        height: 110px;
    }

    .rank-card-avatar h4 {
        font-weight: 600;
    }

    .rank-money {
        color: #8149e2;
        font-weight: 600;
    }

    .rank-card-content {
        margin-top: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex: 1;
        font-size: 14px;
    }

    .rank-card-content button {
        font-weight: bold;
        font-size: 14px;
        padding: 8px;
        border-radius: 5px;
        color: #fff;
    }

    .rank-card-content-top ul,
    .rank-card-content-top ol {
        margin: 0;
        padding: unset;
    }

    .rank-card-content-top li {
        list-style-type: none;
        padding: 12px 0;
        color: #46454e;
        font-weight: 600;
    }

    .rank-card-content-top li:before {
        content: "-";
        text-indent: -5px;
        margin-right: 5px;
    }

    .rank-card-content button {
        transition: all .3s;
    }

    .rank-card-content button:hover {
        box-shadow: 0 8px 25px -8px #071666;
        opacity: 0.8;
    }

    @media (min-width: 521px) and (max-width: 739px) {
        .rank-cards {
            display: flex;
            flex-wrap: wrap;
        }

        .rank-card {
            width: calc(50% - 15px);
            margin-bottom: 30px;
        }

        .rank-card:nth-child(1),
        .rank-card:nth-child(3) {
            margin-left: 0;
        }

        .rank-card:nth-child(2),
        .rank-card:nth-child(4) {
            margin-right: 0;
        }
    }

    @media (max-width: 520px) {
        .rank-cards {
            display: flex;
            flex-wrap: wrap;
            margin-left: unset;
        }

        .rank-card {
            width: 100%;
            margin: 0 0 15px 0;
        }
    }
</style>

<div class="card card-custom mb-2">
    <div class="card-header badge-warning" data-toggle="collapse" data-target="#levelCollapse" aria-expanded="false">
        <div class="card-title-v2">Cấp bậc
            <div class="pull-right card-icon"><i class="fas fa-chevron-right"></i></div>
        </div>
    </div>

    <div class="collapse" id="levelCollapse">
        <div class="card-body" style="padding: 1rem">

            <div class="rank-cards">
                <div class="rank-card">
                    <div class="rank-card-avatar">
                        <img src="https://s3.ap-northeast-1.amazonaws.com/h.files/images/1659436159095_1aPFtNkr3I.png"
                             alt="">
                        <h4><%= functions.typeUser(0) %></h4>
                        <div class="rank-money">
                            <span>0</span>
                            <sup>vnđ</sup>
                        </div>
                    </div>
                    <div class="rank-card-content">
                        <div class="rank-card-content-top">
                            <ul>
                                <li>Cấp độ mặc định</li>
                                <li>Giá không được ưu đãi</li>
                            </ul>
                        </div>
                        <button style="border: 1px solid #28c76f;  background-color: #28c76f;"><%= functions.typeUser(0) %></button>
                    </div>
                </div>
                <div class="rank-card">
                    <div class="rank-card-avatar">
                        <img src="https://s3.ap-northeast-1.amazonaws.com/h.files/images/1659436159095_1aPFtNkr3I.png"
                             alt="">
                        <h4><%= functions.typeUser(1) %></h4>
                        <div class="rank-money">
                            <span>0</span>
                            <sup>vnđ</sup>
                        </div>
                    </div>
                    <div class="rank-card-content">
                        <div class="rank-card-content-top">
                            <ul>
                                <li>Cấp độ mặc định</li>
                                <li>Giá không được ưu đãi</li>
                            </ul>
                        </div>
                        <button style="border: 1px solid #7367f0;  background-color: #7367f0;"><%= functions.typeUser(1) %></button>
                    </div>
                </div>
                <div class="rank-card">
                    <div class="rank-card-avatar">
                        <img src="https://s3.ap-northeast-1.amazonaws.com/h.files/images/1659436182269_nsI68breJZ.png"
                             alt="">
                        <h4><%= functions.typeUser(2) %></h4>
                        <div class="rank-money">
                            <span><%= functions.number_format(config.one_charge_lv2) %></span>
                            <sup>vnđ</sup>
                        </div>
                    </div>
                    <div class="rank-card-content">
                        <div class="rank-card-content-top">
                            <ul>
                                <li>Nạp đủ và thăng cấp tự động</li>
                                <li>1 giao dịch 2 triệu hoặc tổng nạp 5 triệu</li>
                                <li>Được tạo website riêng</li>
                                <li>Giá được ưu đã tốt.</li>
                            </ul>
                        </div>
                        <button style="border: 1px solid #ea5455;  background-color: #ea5455;"><%= functions.typeUser(2) %></button>
                    </div>
                </div>
                <div class="rank-card">
                    <div class="rank-card-avatar">
                        <img src="https://s3.ap-northeast-1.amazonaws.com/h.files/images/1659436204353_K20fVMcbzm.png"
                             alt="">
                        <h4><%= functions.typeUser(3) %></h4>
                        <div class="rank-money">
                            <span><%= functions.number_format(config.one_charge_lv3) %></span>
                            <sup>vnđ</sup>
                        </div>
                    </div>
                    <div class="rank-card-content">
                        <div class="rank-card-content-top">
                            <ul>
                                <li>Nạp đủ và thăng cấp tự động</li>
                                <li>1 giao dịch 50 triệu hoặc tổng nạp 250 triệu</li>
                                <li>Được tạo website riêng</li>
                                <li>Giá được ưu đã tốt nhất, hỗ trợ đặc biệt</li>
                                <li>Được bổ sung các tính năng yêu cầu.</li>
                            </ul>
                        </div>
                        <button style="border: 1px solid #3c51c4;  background-color: #3c51c4;"><%= functions.typeUser(3) %></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card card-custom">
    <div class="card-header badge-success" data-toggle="collapse" data-target="#priceCollapse" aria-expanded="true">
        <div class="card-title-v2"><%= site.title %>
            <div class="pull-right card-icon"><i class="fas fa-chevron-right"></i></div>
        </div>
    </div>

    <div class="collapse show" id="priceCollapse">
        <div class="card-body">
            <% services.map((row, index) => { %>
                <h5 class="collapse-toggle" data-toggle="collapse"
                    data-target="#collapse_<%= index %>"><%= row.label %></h5>

                <div class="collapse" id="collapse_<%= index %>">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover table-price">
                            <thead>
                            <tr>
                                <th style="width: 50px">ID</th>
                                <th style="width: 250px">Tên</th>
                                <th>Ghi chú</th>
                                <th style="width: 50px"><%= functions.typeUser(0) %></th>
                                <th style="width: 50px"><%= functions.typeUser(1) %></th>
                                <th style="width: 50px"><%= functions.typeUser(2) %></th>
                                <th style="width: 50px"><%= functions.typeUser(3) %></th>
                                <th style="width: 100px">Trạng thái</th>
                            </tr>
                            </thead>
                            <tbody>
                            <%
                                let child = Object.keys(row.child);
                                let oldName = null;
                            %>
                            <% child.map(text => {
                                let price = prices[text];
                                if (!price || price.main_hidden) return;
                            %>

                            <%
                                const getName = text => text.replace(/_v(\d+)/, '').replace(/_/g, '').replace(/p\d+/g, '');

                                let groupName = getName(price.name);
                                let hasSeparator = false;
                                if (oldName !== null) {
                                    hasSeparator =
                                            oldName &&
                                            !groupName.match(/reactions|livestream/) &&
                                            (groupName !== oldName) &&
                                            ![16].includes(index)

                                    // Some fixed
                                    if (['reactionslike'].includes(groupName)) hasSeparator = true;
                                    if (['likecoronamax'].includes(groupName)) hasSeparator = false;
                                }

                                if (['like_instagram', 'follow_instagram'].includes(price.name)) hasSeparator = true;

                                oldName = groupName;
                            %>
                            <% if (hasSeparator) { %>
                                <tr class="t-separator">
                                    <td colspan="7">
                                        <div>----------</div>
                                    </td>
                                </tr>
                            <% } %>

                            <tr>
                                <td>
                                    <%= price.id %>
                                </td>
                                <td>
                                    <%= price.display_name %>
                                </td>
                                <td>
                                    <%= price.note %>
                                </td>
                                <td>
                          <span class="badge badge-success">
                            <span class="money-value"><%= functions.number_format(price.price_lv0, false) %></span>
                            <span class="currency-unit">₫</span>
                          </span>
                                </td>
                                <td>
                          <span class="badge badge-primary">
                            <span class="money-value"><%= functions.number_format(price.price_lv1, false) %></span>
                            <span class="currency-unit">₫</span>
                          </span>
                                </td>
                                <td>
                          <span class="badge badge-warning">
                            <span class="money-value"><%= functions.number_format(price.price_lv2, false) %></span>
                            <span class="currency-unit">₫</span>
                          </span>
                                </td>
                                <td>
                          <span class="badge badge-info">
                              <% if (user.ugroup == 3) { %>
                                  <span class="money-value"><%= functions.number_format(price.price_lv3, false) %></span>
                                  <span class="currency-unit">₫</span>
                              <% } else { %>
                                  **
                              <% } %>
                          </span>
                                </td>
                                <td>
                                    <span class="badge badge-<%= price.status %>"><%= pMap[price.status] %></span>
                                </td>
                            </tr>
                            <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% }) %>

            <!--For bank voucher-->
            <h5 class="collapse-toggle" data-toggle="collapse" data-target="#collapse_bank_voucher">Voucher STK</h5>

            <div class="collapse" id="collapse_bank_voucher">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-price">
                        <thead>
                        <tr>
                            <th style="width: 100px">Ngân hàng</th>
                            <th style="width: 250px">Tên voucher</th>
                            <th>Ghi chú</th>
                            <th style="width: 50px">Giá</th>
                            <th style="width: 100px">Trạng thái</th>
                        </tr>
                        </thead>
                        <tbody>
                        <% banks.map(bank => { %>
                            <% bank.bank_vouchers.map(bank_voucher => { %>
                                <tr>
                                    <td class="text-success">
                                        <%= bank.name %>
                                    </td>
                                    <td class="text-primary">
                                        <%= bank_voucher.name %>
                                    </td>
                                    <td>
                                        <%= bank_voucher.note %>
                                    </td>
                                    <td>
                              <span class="badge badge-success">
                                <span class="money-value"><%= functions.number_format(bank_voucher.price, false) %></span>
                                <span class="currency-unit">₫</span>
                              </span>
                                    </td>
                                    <td>
                                        <span class="badge badge-<%= bank_voucher.status %>"><%= pMap[bank_voucher.status] %></span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

