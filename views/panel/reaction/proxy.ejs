<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="far fa-edit" aria-hidden="true"></i>Mua Proxy
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_list" role="tab" aria-selected="false">
                <i class="fas fa-list-alt" aria-hidden="true"></i>Danh Sách Proxy
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i><span style="color: red;">Lịch Sử</span>
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="/reaction/<%= site.type %>">

                                <div class="form-group">
                                    <div class="form-inline">
                                        <label class="mr-2">Chọn server cung cấp:</label>
                                        <div class="radio custom-radio">
                                            <input id="server_vn" name="server" type="radio" value="vn">
                                            <label for="server_vn">VN</label>
                                        </div>

                                        <div class="radio custom-radio">
                                            <input id="server_global" name="server" type="radio" value="global" checked>
                                            <label for="server_global">GLOBAL (ổn định và tốt hơn)</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group list-country" id="list_country_vn">
                                    <label>Proxy nước: </label>
                                    <select name="country_vn" class="form-control">
                                        <option value="us">United States</option>
                                        <option value="de">Germany (Deutschland)</option>
                                        <option value="sg">Singapore</option>
                                        <option value="gb">United Kingdom</option>
                                        <option value="fr">France</option>
                                        <option value="jp">Japan (日本)</option>
                                        <option value="au">Australia</option>
                                        <option value="nl">Netherlands (Nederland)</option>
                                        <option value="ca">Canada</option>
                                        <option value="vn">Vietnam</option>
                                        <option value="in">India</option>
                                        <option value="hk">HongKong</option>
                                        <option value="th">Thailand</option>
                                        <option value="kr">Korean</option>
                                    </select>
                                </div>

                                <div class="form-group list-country" id="list_country_global" style="display: none">
                                    <label>Proxy nước: </label>
                                    <select name="country_global" class="form-control">
                                        <option value="us">United States</option>
                                        <option value="ru">Russia (Россия)</option>
                                        <option value="de">Germany (Deutschland)</option>
                                        <option value="ua">Ukraine (Україна)</option>
                                        <option value="sg">Singapore</option>
                                        <option value="gb">United Kingdom</option>
                                        <option value="fr">France</option>
                                        <option value="jp">Japan (日本)</option>
                                        <option value="au">Australia</option>
                                        <option value="nl">Netherlands (Nederland)</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="period">Gói:</label>
                                    <select name="period" id="period" class="form-control">
                                        <option value="30">1 tháng</option>
                                        <option value="3">3 ngày</option>
                                        <option value="7">1 tuần</option>
                                        <option value="14">2 tuần</option>
                                        <option value="60">2 tháng</option>
                                        <option value="90">3 tháng</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="total">Tổng Giá</label>
                                    <% var userPrice = functions.getUserPrice(price, user.ugroup) %>
                                    <input type="hidden" name="price" id="price" value="<%= userPrice %>"
                                           data-price="<%= userPrice %>"/>
                                    <input type="text" class="form-control" name="total" id="total"
                                           value="<%= functions.number_format(userPrice * 30) %> VNĐ" disabled/>
                                </div>

                                <div class="form-group">
                                    <label for="note">Ghi chú</label>
                                    <textarea class="form-control" id="note" name="note" autocomplete="off" rows="1"
                                              required></textarea>
                                </div>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Mua</button>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_list">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý ID
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <%- include('../components/note.ejs') %>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="kt_list" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-proxy"></table>
            </div>
        </div>

        <div class="tab-pane" id="kt_history" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-ajax"></table>
            </div>
        </div>
    </div>

    <!--begin::Modal-->
    <div class="modal fade" id="modalUpdate" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <form action="<%= '/reaction/proxy/update' %>" method="post" class="form-json">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Sửa</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="id_update" name="id" class="form-control" value="0"/>

                        <div class="form-group">
                            <label>Ghi chú</label>
                            <textarea class="form-control" id="note_update" name="note" autocomplete="off" rows="1"
                                      required></textarea>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                        <button class="btn btn-success" type="submit">Sửa</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <!--end::Modal-->

    <!--begin::Modal-->
    <div class="modal fade" id="modalExtend" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <form action="<%= '/reaction/proxy/extend' %>" method="post" class="form-json">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Gia Hạn</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="order_id_extend" name="order_id" class="form-control" value="0"/>

                        <div class="form-group">
                            <label for="period_extend">Gói:</label>
                            <select name="period" id="period_extend" class="form-control">
                                <option value="3">3 ngày</option>
                                <option value="7">1 tuần</option>
                                <option value="14">2 tuần</option>
                                <option value="30">1 tháng</option>
                                <option value="60">2 tháng</option>
                                <option value="90">3 tháng</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="total_extend">Tổng Giá</label>
                            <input type="text" class="form-control" name="total_extend" id="total_extend"
                                   value="<%= functions.number_format(userPrice) * 3 %> VNĐ" disabled/>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                        <button class="btn btn-success" type="submit">Gia Hạn</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <!--end::Modal-->

</div>

<script>
    var type = "<%= site.type %>";
</script>
