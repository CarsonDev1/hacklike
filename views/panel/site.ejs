        swalSuccess(response.msg);
        let {nameservers} = response;
        $('#list_nameservers').html('');

        nameservers.forEach(line => {
            $('#list_nameservers').append(`<li>${line}</li>`);
        });
    }

    $(document).ready(function () {
        $('#add_order_type').change(function () {
            const orderType = $(this).val();

            const _table = $('#table-add-order');
            _table.find('.options').hide();

            if (orderType !== 'default') _table.find('.options.' + orderType).show();
        })
    });
</script>
