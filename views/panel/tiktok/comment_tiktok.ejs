<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="/tiktok/<%= site.type %>">
                                <div class="form-group">
                                    <label>Link bài viết</label>
                                    <input type="text" class="form-control change-price" id="tiktok_post_link"
                                           name="link"
                                           placeholder="www.tiktok.com/@user/video/123" autocomplete="off" required>
                                </div>

                                <div class="form-group">
                                    <label>Chọn server</label>

                                    <div class="servers">

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_1">Server 1
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_2">Server 2
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_3">Server 3
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_4">Server 4
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_5">Server 5
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_6">Server 6
                                            </label>
                                        </div>

                                    </div>
                                </div>

                                <div class="form-group server-section server_2-visible server_3-visible server_5-visible">
                                    <label for="count"> Số lượng</label>
                                    <input type="number" class="form-control change-price" name="count" id="count"/>
                                </div>

                                <div class="form-group">
                                    <label>Nhập nội dung Comment - Mỗi dòng tương đương với 1 Comment (<span
                                                class="comment_count text-success">0</span>)</label>
                                    <textarea class="form-control change-price has_count" rows="10" name="comments"
                                              data-counter=".comment_count"
                                              placeholder="Nhập nội dung Comment"></textarea>

                                    <div class="alert alert-danger mt-2 text-bold">
                                        Nghiêm cấm bình luận các nội dung có biểu tượng Icon. <br/>
                                        Nghiêm cấm bình luận những nội có cử chỉ, lời nói thô bạo, khiêu khích, trêu
                                        ghẹo, xúc phạm
                                        nhân phẩm, danh dự của Cá nhân hoặc Tổ chức.<br/>
                                        Nếu cố tình buff bạn sẽ bị trừ hết tiền và ban khỏi hệ thống api vĩnh viễn, và
                                        phải chịu
                                        hoàn toàn trách nhiệm trước pháp luật.<br/>
                                        Các ngôn từ bị cấm: dm|đm|đ m|d m|địt mẹ|dit
                                        me|lol|lừađảo|conchó|trảtiền|mấtdạy|lừa đảo|con
                                        chó|trả tiền|mất dạy|lua dao|con cho|tra tien|mat day<br/>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="price">Giá Tiền Mỗi Tương Tác</label>
                                    <input type="number" class="form-control" name="price" id="price" readonly/>
                                </div>

                                <%- include('../components/discount_widget.ejs') %>

                                <div class="form-group">
                                    <label for="total">Tổng Giá</label>
                                    <input type="text" class="form-control" name="total" id="total" disabled/>
                                </div>

                                <div class="form-group">
                                    <label for="note">Ghi chú</label>
                                    <textarea class="form-control" name="note" id="note" rows="1"></textarea>
                                </div>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Mua</button>
                                    -<span style="color:red">Đọc kĩ lưu ý Nếu bạn mua lỗi</span>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_history">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý ID
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <%- include('../components/note.ejs') %>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="kt_history" role="tabpanel">
            <%- include('../components/status_filter.ejs') %>

            <table class="table table-bordered table-hover" id="datatable-ajax"></table>
        </div>
    </div>
</div>
<script>
    var type = "<%= site.type %>";
</script>
