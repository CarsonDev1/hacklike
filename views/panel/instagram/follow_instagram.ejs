<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="/instagram/<%= site.type %>">
                                <div class="form-group">
                                    <label>Link profile</label>
                                    <input type="url" id="url" class="form-control" name="link"
                                           placeholder="https://www.instagram.com/username/" autocomplete="off"
                                           required>

                                    <%- include('../components/div_uid_error') %>
                                </div>

                                <div class="form-group">
                                    <label>Chọn server</label>

                                    <div class="servers form-group">
                                        <div class="title">Sub việt</div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_1" checked>Server 1
                                            </label>
                                        </div>
                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_2">Server 2
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_4">Server 4
                                            </label>
                                        </div>

                                    </div>

                                    <div class="servers form-group">
                                        <div class="title">Sub tây</div>

                                        <%
                                        let serverMap = {
                                            server_3: 'Server 3',
                                            server_5: 'Server 5',
                                            server_6: 'Server 6',
                                            server_7: 'Server 7',
                                            server_8: 'Server 8',
                                            server_9: 'Server 9',
                                            server_10: 'Server 10'
                                        };
                                        %>

                                        <% Object.keys(serverMap).forEach(server => { %>
                                            <div class="radio radio-server">
                                                <label><input type="radio" name="server" value="<%= server %>">
                                                    <%= serverMap[server] %>
                                                </label>
                                            </div>
                                        <% }) %>

                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="count">Số lượng (Khuyên: Ae Mua Tăng dư 15%)</label>
                                    <input type="number" class="form-control" name="count" id="count" min="10"
                                           value="10"/>
                                </div>

                                <div class="form-group server-section server_2-visible server_4-visible">
                                    <label for="speed">Tốc độ</label>
                                    <select name="speed" class="form-control" required>
                                        <option value="0">Nhanh</option>
                                        <option value="15">Trung bình</option>
                                        <option value="50">Chậm</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="price">Giá Tiền Mỗi Tương Tác</label>
                                    <input type="number" class="form-control" name="price" id="price" disabled/>
                                </div>

                                <%- include('../components/discount_widget.ejs') %>

                                <div class="form-group">
                                    <label for="total">Tổng Giá</label>
                                    <input type="text" class="form-control" name="total" id="total" disabled/>
                                </div>

                                <div class="form-group">
                                    <label for="note">Ghi chú</label>
                                    <textarea class="form-control" name="note" id="note" rows="1"></textarea>
                                </div>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Mua</button>
                                    -<span style="color:red">Đọc kĩ lưu ý Nếu lỗi</span>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_history">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý ID
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <%- include('../components/note.ejs') %>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="kt_history" role="tabpanel">
            <%- include('../components/status_filter.ejs') %>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-ajax"></table>
            </div>
        </div>
    </div>
</div>
<script>
    var type = "<%= site.type %>";
</script>
