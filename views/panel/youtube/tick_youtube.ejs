<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="/youtube/<%= site.type %>">
                                <div class="form-group">
                                    <label>Link Kênh Youtube</label>
                                    <input type="text" class="form-control change-price" name="link"
                                           placeholder="https://www.youtube.com/channel/abc" autocomplete="off"
                                           data-obj="youtube"
                                           required>
                                </div>

                                <div class="form-group">
                                    <label>Chọn server</label>

                                    <div class="servers">
                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_1">Server 1
                                            </label>
                                        </div>

                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Email Quản Trị Đã Thêm</label>

                                    <% var emails = [
                                        'erickaagee2645@gmail.com'
                                    ] %>
                                    <div>
                                        <% emails.forEach(email => { %>
                                            <div class="radio">
                                                <label><input type="radio" name="email" value="<%= email %>"
                                                              required><%= email %>
                                                </label>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Link FaceBook hoặc Zalo của bạn để liên hệ khi lỗi</label>
                                    <input type="text" class="form-control" name="contact" required
                                           placeholder="Link FaceBook hoặc Zalo"/>
                                </div>

                                <div class="form-group">
                                    <label for="total">Tổng Giá</label>
                                    <% var userPrice = functions.getUserPrice(price, user.ugroup) %>
                                    <input type="text" class="form-control" name="total" id="total"
                                           data-price="<%= functions.number_format(userPrice) %>"
                                           value="<%= functions.number_format(userPrice) %> VND" disabled/>
                                </div>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Mua</button>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_history">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý ID
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <%- include('../components/note.ejs') %>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="kt_history" role="tabpanel">
            <%- include('../components/status_filter.ejs') %>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-ajax"></table>
            </div>
        </div>
    </div>
</div>
<script>
    var type = "<%= site.type %>";
</script>

