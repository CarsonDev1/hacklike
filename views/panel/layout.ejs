                        %>
    
                        <ul class="kt-menu__nav ">
                            <% sideLinks.forEach(parent => { %>
                                <% if (parent.icon && parent.child) { %>
                                    <li class="kt-menu__item  kt-menu__item--submenu" aria-haspopup="true"
                                        data-ktmenu-submenu-toggle="hover">
                                        <a href="javascript:" class="kt-menu__link kt-menu__toggle">
                                            <span class="kt-menu__link-icon"><i class="<%= parent.icon %>"></i></span>
                                            <span class="kt-menu__link-text"><%- parent.text %></span><i
                                                    class="kt-menu__ver-arrow fas fa-angle-right"></i></a>
                                        <div class="kt-menu__submenu "><span class="kt-menu__arrow"></span>
                                            <ul class="kt-menu__subnav">
                                                <% parent.child.map(item => { %>
                                                    <% if (item.child) { %>
                                                        <li class="kt-menu__item  kt-menu__item--submenu"
                                                            aria-haspopup="true"
                                                            data-ktmenu-submenu-toggle="hover">
                                                            <a href="javascript:" class="kt-menu__link kt-menu__toggle">
    
                                                                <% if (item.icon) { %>
                                                                    <span class="kt-menu__link-icon"><i
                                                                                class="<%= item.icon %>"
                                                                                aria-hidden="true"></i></span>
                                                                <% } else { %>
                                                                    <i class="kt-menu__link-bullet kt-menu__link-bullet--dot"><span></span></i>
                                                                <% } %>
    
                                                                <span class="kt-menu__link-text"><%= item.text %></span><i
                                                                        class="kt-menu__ver-arrow fas fa-angle-right"></i></a>
                                                            <div class="kt-menu__submenu "><span
                                                                        class="kt-menu__arrow"></span>
                                                                <ul class="kt-menu__subnav">
                                                                    <% item.child.map(item2 => { %>
                                                                        <li class="kt-menu__item"
                                                                            aria-haspopup="true">
                                                                            <a href="<%= item2.link || ('/' + item.name + '/' + item2.type) %>"
                                                                               class="kt-menu__link"
                                                                                    <%= item2.is_link ? ' target="_blank" ' : '' %>>
    
                                                                                <% if (item2.icon) { %>
                                                                                    <span class="kt-menu__link-icon"><i
                                                                                                class="<%= item2.icon %>"
                                                                                                aria-hidden="true"></i></span>
                                                                                <% } else { %>
                                                                                    <i class="kt-menu__link-bullet kt-menu__link-bullet--dot"><span></span></i>
                                                                                <% } %>
    
                                                                                <span class="kt-menu__link-text just-text"><%- item2.text %></span>
                                                                            </a>
                                                                        </li>
                                                                    <% }) %>
                                                                </ul>
                                                            </div>
                                                        </li>
                                                    <% } else { %>
    
    
                                                        <% if (!(account.username === 'testuser' && ['payment', 'site', 'referral', 'profile'].includes(item.type))) { %>
                                                            <!--Special user-->
                                                            <li class="kt-menu__item"
                                                                aria-haspopup="true">
                                                                <a href="<%= item.link || ('/' + parent.name + '/' + item.type) %>"
                                                                   class="kt-menu__link" <%= item.is_link ? ' target="_blank" ' : '' %>>
                                                                    <% if (item.icon) { %>
                                                                        <span class="kt-menu__link-icon"><i
                                                                                    class="<%= item.icon %>"
                                                                                    aria-hidden="true"></i></span>
                                                                    <% } else { %>
                                                                        <i class="kt-menu__link-bullet kt-menu__link-bullet--dot"><span></span></i>
                                                                    <% } %>
                                                                    <span class="kt-menu__link-text just-text"><%- item.text %></span>
                                                                </a>
                                                            </li>
                                                        <% } %>
    
                                                    <% } %>
                                                <% }) %>
                                            </ul>
                                        </div>
                                    </li>
                                <% }
                                else if (parent.type) { %>
                                    <li class="kt-menu__item menu-item-<%= parent.type %>" aria-haspopup="true">
                                        <a href="<%= parent.link %>" class="kt-menu__link ">
                                            <span class="kt-menu__link-icon"><i class="<%= parent.icon %>"></i></span>
                                            <span class="kt-menu__link-text"><%- parent.text %></span>
                                        </a>
                                    </li>
                                <% } else { %>
                                    <li class="kt-menu__section ">
                                        <h4 class="kt-menu__section-text"><%= parent.text %></h4>
                                        <i class="kt-menu__section-icon"></i>
                                    </li>
                                <% } %>
                            <% }) %>
    
