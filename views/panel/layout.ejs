                                <a class="nav-link" href="#"><%= parent.text %></a>
                                <div class="dropdown-menu">
                                    <% parent.child.forEach(item => { %>
                                        <div class="dropdown-submenu">
                                            <% if (item.child) { %>
                                                <a class="nav-link has-dropdown" href="#"><%= item.text %></a>
                                                <div class="dropdown-menu">
                                                    <% item.child.forEach(item2 => { %>
                                                        <a class="dropdown-item"
                                                           href="<%= item2.link || ('/' + item.name + '/' + item2.type) %>"><%- item2.text %></a>
