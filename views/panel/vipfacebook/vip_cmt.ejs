<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_list" role="tab" aria-selected="false">
                <i class="fas fa-shopping-bag" aria-hidden="true"></i>Danh Sách VIP
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="/vipfacebook/<%= site.type %>">
                                <div class="form-group">
                                    <label>ID hoặc link tài khoản cần chạy</label>
                                    <input type="text" class="form-control" id="link" name="uid"
                                           placeholder="Id hoặc link tài khoản cần chạy vip" autocomplete="off"
                                           required>

                                    <%- include('../components/div_uid_error') %>
                                </div>

                                <div class="form-group">
                                    <label for="name">Tên facebook cá nhân</label>
                                    <input type="text" class="form-control" id="name" name="name"
                                           placeholder="Tên tài khoản cần chạy vip"
                                           autocomplete="off" required>
                                </div>

                                <div class="form-group">
                                    <label>Chọn server</label>

                                    <div class="servers">
                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_1">Server 1
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_2">Server 2
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_3">Server 3
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_4">Server 4
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label for="vip_package">Chọn Gói VIP</label>
                                            <select class="form-control change-price" name="vip_package"
                                                    id="vip_package">
                                                <% for (let i = 5; i <= 100; i += 5) { %>
                                                    <option value="<%= i %>"><%= i %> comment</option>
                                                <% } %>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Thời Gian</label>
                                            <select class="form-control change-price" name="days" id="days">
                                                <option value="7">7 ngày</option>
                                                <option value="30">1 tháng</option>
                                                <option value="60">2 tháng</option>
                                                <option value="90">3 tháng</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-md-12 form-group server-section server_1-visible">
                                        <label>Tốc độ 2 lần cmt (tính theo phút)</label>
                                        <input type="number" class="form-control" name="time_delay" value="1" min="1"
                                               max="30"
                                               required/>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="comments">Nội dung comments (Sử dụng icon kí tự: <a
                                                href="https://s3.ap-northeast-1.amazonaws.com/h.files/images/1635743989143_X6wQbxVRQj.jpg"
                                                target="_blank">Tại đây</a>)</label>
                                    <textarea class="form-control"
                                              placeholder="Mỗi cmt một hàng. nên điền nhiều cmt để random cho bài đẹp k trùng cmt"
                                              id="comments" name="comments" rows="10" required></textarea>
                                </div>

                                <div class="form-group">
                                    <label for="price">Giá Tiền Mỗi Tương Tác (VNĐ/cmt/tháng)</label>
                                    <input type="number" class="form-control" id="price" value="" disabled/>
                                </div>

                                <%- include('../components/discount_widget.ejs') %>

                                <div class="form-group">
                                    <label for="total">Tổng Giá</label>
                                    <input type="text" class="form-control" name="total" id="total"
                                           value="" disabled/>
                                </div>

                                <div class="form-group">
                                    <label for="note">Ghi chú</label>
                                    <textarea class="form-control" name="note" rows="1"></textarea>
                                </div>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Mua</button>
                                    <!-- <small class="form-text text-danger font-weight-bold">mua vip 5cmt điền 20-40 dòng thôi, điền nhiều dòng cài sẽ báo lỗi</small> -->
                                </div>
                                <div class="form-group">
                                    <a href="https://notepad.pw/share/xs2mjr0xt" class="btn btn-success text-white"
                                       target="_blank">Comment mẫu</a>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_list">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý ID
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <%- include('../components/note.ejs') %>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="kt_list" role="tabpanel">
            <%- include('../components/server_filter.ejs') %>

            <%- include('../components/vip_status_filter.ejs') %>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-vips"></table>
            </div>
        </div>
        <div class="tab-pane" id="kt_history" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-ajax"></table>
            </div>
        </div>
    </div>

    <!--begin::Modal-->
    <div class="modal fade" id="modalUpdate" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <form id="formUpdate" action="<%= `/vipfacebook/${site.type}/update` %>" method="post">
                <input type="hidden" name="id">

                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Sửa</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <div class="modal-body">

                        <div class="form-group">
                            <label for="comments">Nội dung comments</label>
                            <textarea class="form-control" placeholder="Mỗi cmment một hàng" name="comments"
                                      rows="10"></textarea>
                        </div>

                        <div class="form-group">
                            <label for="note">Ghi chú</label>
                            <textarea class="form-control" name="note" rows="1"></textarea>
                        </div>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary">Cập Nhật</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../components/modal_add_post.ejs') %>
<%- include('../components/modal_stickers.ejs') %>
<%- include('../components/modal_posts.ejs') %>

<script src="/assets/js/stickers.js"></script>
<script>
    var type = "<%= site.type %>";
</script>
