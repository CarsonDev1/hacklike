          content="Hệ thống chuyên cung cấp các dịch vụ MXH Facebook/Instagram/Youtube/Tiktok... giá rẻ, đảm bảo uy tín chất lượng">

    <meta itemprop="name" content="HackLike17.com hệ thống dịch vụ mạng xã hội hàng đầu, Social Media Marketing Panel"/>
    <meta itemprop="description"
          content="Hệ thống chuyên cung cấp các dịch vụ MXH Facebook/Instagram/Youtube/Tiktok... giá rẻ, đảm bảo uy tín chất lượng"/>

    <meta property="og:type" content="website"/>
    <meta property="og:title"
          content="HackLike17.com hệ thống dịch vụ mạng xã hội hàng đầu, Social Media Marketing Panel"/>
    <meta property="og:description"
          content="Hệ thống chuyên cung cấp các dịch vụ MXH Facebook/Instagram/Youtube/Tiktok... giá rẻ, đảm bảo uy tín chất lượng"/>
    <meta property="og:image" content="https://hacklike17.com/assets/images/banner.webp"/>
    <meta property="og:image:alt"
          content="HackLike17.com hệ thống dịch vụ mạng xã hội hàng đầu, Social Media Marketing Panel"/>
    <link rel="shortcut icon" href="/assets/images/favicon.ico"/>

    <link href="/assets/css/auth.css?v=<%= version %>" rel="stylesheet preload" type="text/css" as="style"/>

    <script type="application/ld+json">
        {
            "@context": "http://schema.org",
            "@graph": [
                {
                    "@type": "WebSite",
                    "name": "HackLike17",
                    "alternateName": "HackLike17.com hệ thống dịch vụ mạng xã hội hàng đầu, Social Media Marketing Panel",
                    "url": "https://hacklike17.com"
                },
                {
                    "@type": "WebPage",
                    "name": "HackLike17.com hệ thống dịch vụ mạng xã hội hàng đầu, Social Media Marketing Panel",
                    "speakable": {
                        "@type": "SpeakableSpecification",
                        "xpath": [
                            "/html/head/title",
                            "/html/head/meta[@name='description']/@content"
                        ]
                    },
                    "inLanguage": "vi",
                    "description": "Hệ thống chuyên cung cấp các dịch vụ MXH Facebook/Instagram/Youtube/Tiktok... giá rẻ, đảm bảo uy tín chất lượng",
                    "url": "https://hacklike17.com/"
                },
                {
                    "@type": "Organization",
                    "name": "HackLike17",
                    "alternateName": "HackLike17.com hệ thống dịch vụ mạng xã hội hàng đầu, Social Media Marketing Panel",
                    "url": "https://hacklike17.com/",
                    "email": "contact@hacklike17.com",
                    "logo": "https://hacklike17.com/assets/images/logo.webp"
                },
                {
                    "@type": "WebApplication",
                    "name": "HackLike17",
                    "alternateName": "HackLike17.com hệ thống dịch vụ mạng xã hội hàng đầu, Social Media Marketing Panel",
                    "url": "https://hacklike17.com/",
                    "image": "https://hacklike17.com/assets/images/logo.webp",
                    "operatingSystem": "Windows, Linux, iOS, Android, OSX, macOS",
                    "applicationCategory": "UtilitiesApplication",
                    "featureList": [
                        "Facebook Buff Reaction",
                        "Facebook Buff View",
                        "Instagram Buff Reaction",
                        "Tiktok Buff Reaction",
                        "Youtube Buff Reaction"
                    ],
                    "contentRating": "Everyone",
                    "aggregateRating": {
                        "@type": "AggregateRating",
                        "ratingValue": "4.88",
                        "reviewCount": "139"
                    },
                    "offers": {
                        "@type": "Offer",
                        "price": "0"
                    }
                }
            ]
        }
    </script>

    <!--  <link href="/assets/css/new-year.css" rel="stylesheet" type="text/css" />-->
    <% if (enableCaptcha) { %>
        <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <% } %>
</head>

<body
        class="kt-offcanvas-panel--right kt-header--fixed kt-header-mobile--fixed kt-subheader--fixed kt-subheader--enabled kt-subheader--solid auth-page">

<%- include('../components/theme.ejs') -%>

<!-- begin:: Page -->
<div class="kt-grid kt-grid--ver kt-grid--root">
    <div class="kt-grid kt-grid--hor kt-grid--root  kt-login kt-login--v4 kt-login--signin" id="kt_login">
        <div class="kt-grid__item kt-grid__item--fluid kt-grid kt-grid--hor has-background">

            <div class="kt-grid__item kt-grid__item--fluid kt-login__wrapper">
                <div class="kt-login__container">
                    <div class="kt-login__logo">
                        <a href="/"
                           aria-label="HackLike17.com hệ thống dịch vụ mạng xã hội hàng đầu, Social Media Marketing Panel">
                            <img src="/assets/images/logo.webp" width="200px" alt="">
                        </a>
                    </div>
                    <div class="kt-login__signin">
                        <div class="kt-login__head">
                            <h3 class="kt-login__title">Đăng Nhập</h3>
                        </div>
                        <form id="frmAuth" class="kt-form login-form" action="<%= '/auth/login/' %>">
                            <div class="input-group">
                                <input class="form-control auto-lowercase" type="text" placeholder="Tên đăng nhập"
                                       name="username"
                                       autocomplete="off"
                                       required maxlength="100">
                            </div>
                            <div class="input-group">
                                <input class="form-control" type="password" placeholder="Password" name="password"
                                       required>
                            </div>
                            <br>
                            <div class="kt-login__actions">
                                <% if (enableCaptcha) { %>
                                    <div class="captcha-container">
                                        <div class="g-recaptcha"
                                             data-sitekey="6LeVuU8pAAAAAKmAKPp-HiA0jR1l6xKUK5Tj6PtK"
                                             data-callback="onSubmit"
                                        >
                                        </div>
                                    </div>
                                <% } %>

                                <button type="submit" class="btn btn-brand btn-pill kt-login__btn-primary btn-submit">
                                    Đăng Nhập
                                </button>
                                <button type="button"
                                        class="btn btn-success btn-pill kt-login__btn-primary btn-register">Đăng ký
                                </button>
                            </div>
                        </form>
                    </div>
                    <div class="kt-login__account">
              <span class="kt-login__account-msg">
                Bạn muốn xem thử chức năng ?
              </span>
                        &nbsp;
                        <span class="kt-login__account-link btn-try c-pointer">Xem thử</span>
                        <br/>
                        <a href="<%= '/forgot_pass/' %>" class="kt-login__account-link link-forgot-pass">Quên mật
                            khẩu?</a>
                    </div>

                    <% if (!googleBot) { %>
                        <%- include('./components/google_translate') %>
                    <% } %>

                </div>
            </div>
        </div>
    </div>
</div>

<!--begin:: Global Mandatory Vendors -->
<script src="/assets/plugins/jquery/jquery.min.js" type="text/javascript"></script>
<script src="/assets/plugins/sweetalert2/sweetalert2.min.js?v=<%= version %>" type="text/javascript"></script>
<script src="/assets/js/auth.js?v=<%= version %>" type="text/javascript"></script>

<%- // include('../components/fb_chat_widget.ejs')  %>
<%- include('./components/right_icons.ejs') %>

</body>

</html>