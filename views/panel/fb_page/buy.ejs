<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#tab-2" role="tab" aria-selected="true">
                <i class="fa fa-facebook-official" aria-hidden="true"></i>Đã mua
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">
                        <div class="card-header bg-success text-white">
                            Mua
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-striped table-bordered table-hover"
                                       id="datatable-pages"></table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <%- include('../components/note.ejs') %>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="tab-2" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-sold-pages"></table>
            </div>
        </div>
        <div class="tab-pane" id="kt_history" role="tabpanel">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-logs"></table>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalBuy" tabindex="-1" role="dialog" style="display: none;" aria-hidden="true">
        <div class="modal-dialog modal-xl" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Tạo mới</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <form method="post" action="<%= `/fb_page/create` %>">
                    <div class="modal-body">
                        <input type="hidden" name="id">
                        <div class="form-group">
                            <label>Số tiền phải trả</label>
                            <input class="form-control" id="page_price" readonly>
                        </div>

                        <div class="form-group">
                            <label>Link cần set QTV(link phải có username)</label>
                            <input class="form-control" name="admin_facebook" placeholder="Admin Facebook" required>
                        </div>

                        <div class="form-group">
                            <label>Thông tin liên hệ(Zalo hoặc link fb-báo khi gặp lỗi)</label>
                            <input id="name" class="form-control" name="contact_info" placeholder="Thông tin liên hệ"
                                   required>
                        </div>

                        <div class="form-group">
                            <label>Tên mới (Nếu không cần thì không điền)</label>
                            <input class="form-control" name="new_name"
                                   placeholder="Tên Không được In hoa hết, Không chứa kí tự đặc biệt">
                        </div>

                        <div class="form-group">
                            <label>Ghi Chú</label>
                            <input class="form-control" name="note" placeholder="Ghi Chú">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="submit" class="btn btn-success">Hoàn Tất</button>
                        <button type="button" class="btn btn-secondary btn-hide-notify" data-dismiss="modal">Đóng
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</div>
<script>
    var type = "<%= site.type %>";
</script>
<script src="/assets/js/datatable-pages.js" type="text/javascript"></script>

