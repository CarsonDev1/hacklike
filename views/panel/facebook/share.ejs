<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="/facebook/<%= site.type %>">
                                <div class="form-group">
                                    <input type="hidden" name="url" id="url"/>
                                    <label for="uid">ID hoặc link bài viết cần chạy</label>
                                    <input type="text" class="form-control" id="uid" name="uid"
                                           placeholder="https://www.facebook.com/username/posts/idfb" autocomplete="off"
                                           required>
                                </div>

                                <div class="form-group">
                                    <label>Chọn server</label>

                                    <div class="servers">

                                        <div class="title">Share việt</div>

                                        <div class="radio radio-server">
                                            <label>
                                                <input type="radio" name="server" value="server_3">Server 3
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label>
                                                <input type="radio" name="server" value="server_1">Server 1
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label>
                                                <input type="radio" name="server" value="server_2">Server 2
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label>
                                                <input type="radio" name="server" value="server_6">Server 6
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label>
                                                <input type="radio" name="server" value="server_7">Server 7
                                            </label>
                                        </div>

                                        <div class="title separator">Share ảo</div>

                                        <div class="radio radio-server">
                                            <label>
                                                <input type="radio" name="server" value="server_4">Server 4
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label>
                                                <input type="radio" name="server" value="server_8">Server 8
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label>
                                                <input type="radio" name="server" value="server_5">Server 5
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="count">Số lượng</label>
                                    <input type="number" class="form-control" name="count" id="count" min="50"
                                           value="50"/>
                                </div>

                                <div class="form-group server-section server_2-visible server_7-visible">
                                    <label>
                                        Nội dung chia sẻ (<span class="text-bold content_count">0</span>)
                                        <span class="server-section server_2-visible">(Bỏ trống nếu bạn k cần share kèm hashtag hay nội dung)</span>
                                        <span class="server-section server_7-visible text-danger">(Bắt buộc nhập với server này. Số lượng mua = số hàng)</span>
                                    </label>
                                    <textarea class="form-control has_count" name="content"
                                              placeholder="Nội dung chia sẻ, mỗi hàng 1 nội dung, Số lượng nội dung lớn hơn sl mua."
                                              rows="5" data-counter=".content_count"></textarea>
                                </div>

                                <div class="form-group">
                                    <label for="price">Giá Tiền Mỗi Tương Tác</label>
                                    <input type="number" class="form-control" name="price" id="price" readonly/>
                                </div>

                                <%- include('../components/discount_widget.ejs') %>

                                <div class="form-group">
                                    <label for="total">Tổng Giá</label>
                                    <input type="text" class="form-control" name="total" id="total" disabled/>
                                </div>

                                <div class="form-group">
                                    <label for="note">Ghi chú</label>
                                    <textarea class="form-control" name="note" id="note" rows="1"></textarea>
                                </div>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Mua</button>
                                </div>
                                <small class="form-text text-danger font-weight-bold">Bài share chứa link https vui lòng
                                    test trước, vì nó có thể không hiển thị số lượng share</small><br>
                                <div class="form-group">
                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_history">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý ID
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <%- include('../components/note.ejs') %>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="kt_history" role="tabpanel">
            <%- include('../components/status_filter.ejs') %>
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-ajax"></table>
            </div>
        </div>
    </div>
</div>

<script>
    var type = "<%= site.type %>";
</script>
