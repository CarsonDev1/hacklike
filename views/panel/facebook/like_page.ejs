<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="<%= '/facebook/like_page' %>">
                                <div class="form-group">
                                    <label for="link">ID hoặc link page cần tăng like</label>
                                    <input type="text" class="form-control" id="link" name="uid"
                                           placeholder="https://www.facebook.com/username" autocomplete="off" required>

                                    <%- include('../components/div_uid_error') %>
                                </div>

                                <div class="form-group">
                                    <label for="name">Tên fanpage chạy like sub</label>
                                    <input type="text" class="form-control" id="name" name="name"
                                           placeholder="Tên tài khoản cần chạy like sub"
                                           autocomplete="off" required>
                                </div>

                                <div class="form-group">
                                    <label>Chọn server</label>

                                    <%
                                    let serverMap = {
                                        server_1: 'Server 1',
                                        server_2: 'Server 2',
                                        server_3: 'Server 3',
                                        server_4: 'Server 4',
                                        server_5: 'Server 5',
                                        server_6: 'Server 6',
                                        server_7: 'Server 7',
                                        server_8: 'Server 8',
                                        server_9: 'Server 9',
                                        server_10: 'Server 10',
                                        server_11: 'Server 11',
                                        server_12: 'Server 12',
                                        server_13: 'Server 13',
                                        server_14: 'Server 14',
                                        server_15: 'Server 15',
                                        server_16: 'Server 16'
                                    };
                                    %>

                                    <% Object.keys(serverMap).forEach(server => { %>
                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="<%= server %>">
                                                <%= serverMap[server] %>
                                            </label>
                                        </div>

                                        <% if (server == 'server_5') { %>
                                            <div class="server-info" id="sv5_running_orders" style="display: none">
                                                Đang có <b>_</b> đơn đang chạy
                                            </div>
                                        <% } %>

                                        <% if (server == 'server_7') { %>
                                            <hr/>
                                        <% } %>
                                    <% }) %>

                                </div>

                                <div class="form-group server-section server_11-visible server_12-visible">
                                    <label>Tốc độ</label>
                                    <select name="speed" class="form-control">
                                        <option value="0">Nhanh</option>
                                        <option value="15">Trung bình</option>
                                        <option value="50">Chậm</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="count">Số Lượng Mua</label>
                                    <input type="number" class="form-control" name="count" id="count"/>
                                </div>

                                <div class="form-group">
                                    <label for="price">Giá Tiền Mỗi Tương Tác</label>
                                    <input type="number" class="form-control" name="price" id="price"/>
                                </div>

                                <%- include('../components/discount_widget') %>

                                <div class="form-group">
                                    <label for="total">Tổng Giá</label>
                                    <input type="text" class="form-control" name="total" id="total" disabled/>
                                </div>

                                <div class="form-group">
                                    <label for="note">Ghi chú</label>
                                    <textarea class="form-control" name="note" id="note" rows="1"></textarea>
                                </div>

                                <br>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Mua</button>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_history">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý ID
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <%- include('../components/note') %>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="kt_history" role="tabpanel">
            <%- include('../components/status_filter') %>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-ajax"></table>
            </div>
        </div>
    </div>
</div>

<script>
    var type = "<%= site.type %>";
</script>

