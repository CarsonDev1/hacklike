<% layout("panel/layout") %>
<link rel="stylesheet" href="/assets/css/facebook-service.css" />
<%- include('../widget.ejs') %>
<div class="content-container">
  <ul
    class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
    role="tablist"
  >
    <li class="nav-item">
      <a
        class="nav-link active"
        data-toggle="tab"
        href="#kt_add"
        role="tab"
        aria-selected="true"
      >
        <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
      </a>
    </li>
    <li class="nav-item">
      <a
        class="nav-link"
        data-toggle="tab"
        href="#kt_history"
        role="tab"
        aria-selected="false"
      >
        <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
      </a>
    </li>
  </ul>
  <div class="tab-content">
    <div class="tab-pane active" id="kt_add" role="tabpanel">
      <div class="row">
        <div class="col-md-8">
          <div class="card form-group">
            <div class="card-body">
              <form id="formUserAction" action="/facebook/<%= site.type %>">
                <div class="form-group">
                  <label for="uid">ID hoặc link bài viết cần chạy</label>
                  <input
                    type="text"
                    class="form-control"
                    id="uid"
                    name="uid"
                    placeholder="https://www.facebook.com/username/posts/idfb"
                    autocomplete="off"
                    required
                  />
                </div>
                <div class="servers form-group">
                  <div
                    class="server-card d-flex align-items-start justify-content-between"
                  >
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="radio"
                        name="server"
                        id="server1"
                        checked
                      />
                      <label class="form-check-label" for="server1">
                        <strong>Server 1:</strong> Tăng chậm
                        <strong>50 đ</strong><br />
                        <small>ID: 28 — Tối thiểu/Tối đa: 20 / 5k</small>
                      </label>
                    </div>
                    <span class="badge bg-danger text-white badge-custom"
                      >Ngừng nhận đơn</span
                    >
                  </div>

                  <!-- Server 2 -->
                  <div
                    class="server-card d-flex align-items-start justify-content-between"
                  >
                    <div class="form-check">
                      <input
                        class="form-check-input"
                        type="radio"
                        name="server"
                        id="server2"
                        checked
                      />
                      <label class="form-check-label" for="server2">
                        <strong>Server 2:</strong> Tăng chậm <strong>50</strong
                        ><br />
                        <small>ID: 28 — Tối thiểu/Tối đa: 20 / 5k</small>
                      </label>
                    </div>
                    <span class="badge bg-danger text-white badge-custom"
                      >Ngừng nhận đơn</span
                    >
                  </div>
                  <div
                  class="server-card d-flex align-items-start justify-content-between"
                >
                  <div class="form-check">
                    <input
                      class="form-check-input"
                      type="radio"
                      name="server"
                      id="server2"
                      checked
                    />
                    <label class="form-check-label" for="server2">
                      <strong>Server 3:</strong> Tăng chậm <strong>50</strong
                      ><br />
                      <small>ID: 28 — Tối thiểu/Tối đa: 20 / 5k</small>
                    </label>
                  </div>
                  <span class="badge bg-danger text-white badge-custom"
                    >Ngừng nhận đơn</span
                  >
                </div>
                </div>
                <div class="form-group">
                  <%- include('../components/fb_reaction.ejs') %>
                </div>
                <div class="form-group d-flex align-items-center">
                  <label for="count" class="text-nowrap fbw-option"
                    >Số lượng:
                  </label>
                  <input
                    type="number"
                    class="form-control ml-2"
                    name="count"
                    id="count"
                    min="10"
                    value="10"
                  />
                </div>
                <div class="form-group d-flex align-items-center">
                  <label for="price" class="text-nowrap fbw-option"
                    >Giá tiền:
                  </label>
                  <input
                    type="number"
                    class="form-control ml-2"
                    name="price"
                    id="price"
                  />
                </div>
                <!-- <%- include('../components/discount_widget.ejs') %> -->
                <div class="form-group d-flex align-items-center">
                  <label for="total" class="text-nowrap fbw-option"
                    >Tổng Giá:
                  </label>
                  <input
                    type="text"
                    class="form-control ml-2"
                    name="total"
                    id="total"
                    disabled
                  />
                </div>
                <div class="form-group d-flex align-items-center">
                  <label for="note" class="text-nowrap fbw-option"
                    >Ghi chú:
                  </label>
                  <textarea
                    class="form-control ml-2"
                    name="note"
                    id="note"
                    rows="1"
                  ></textarea>
                </div>
                <br />
                <div class="form-group">
                  <button
                    id="submit"
                    class="btnc-base btnc-success text-bold"
                    type="submit"
                  >
                    <i class="fa fa-shopping-cart"></i> Mua
                  </button>
                </div>

                <div class="">
                  <button
                    class="btnc-base btnc-danger text-bold btn-view-history"
                    type="button"
                    data-target="#kt_history"
                  >
                    <i class="fa fa-calendar"></i> Quản Lý ID
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
        <div class="col-md-4"><%- include('../components/note.ejs') %></div>
      </div>
    </div>
    <div class="tab-pane" id="kt_history" role="tabpanel">
      <%- include('../components/status_filter.ejs') %>
      <div class="table-responsive">
        <table
          class="table table-bordered table-hover"
          id="datatable-ajax"
        ></table>
      </div>
    </div>
  </div>
</div>
<script>
  var type = "<%= site.type %>";
</script>
