<% layout("panel/layout") %>
<link rel="stylesheet" href="/assets/css/facebook-service.css">Add commentMore actions
<%- include('../widget.ejs') %>
    <div class="content-container">
        <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                    <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                    <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
                </a>
            </li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane active" id="kt_add" role="tabpanel">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card form-group">
                            <div class="card-body">
                                <form id="formUserAction" action="/facebook/<%= site.type %>">
                                    <div class="form-group">
                                        <label for="uid">ID hoặc link bài viết cần chạy</label>
                                        <input type="text" class="form-control" id="uid" name="uid"
                                            placeholder="https://www.facebook.com/username/posts/idfb"
                                            autocomplete="off" required>
                                    </div>
                                    <div class="servers form-group">
                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_1" checked>Server
                                                1 </label>
                                        </div>
                                        <div class="id-info-box">
                                            <span class="id-text">ID: 28</span>
                                            <span class="limit-text">Tối thiểu/Tối đa: 20/5k</span>
                                        </div>
                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_2">Server 2
                                            </label>
                                        </div>
                                        <div class=""
                                            style="border-radius: 10px; background: rgb(254, 233, 178); border: 1px solid rgb(243, 245, 249); display: flex; flex-direction: column;">
                                            <h6 class="font-bold text-danger mb-0" style="padding: 20px;">Đây là mục
                                                like chậm<br> Chọn mục " Like facebook speed" Nếu cần nhanh và
                                                rẻ<br>
                                            </h6>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <%- include('../components/fb_reaction.ejs') %>
                                    </div>
                                    <div class="form-group d-flex align-items-center">
                                        <label for="count" class="text-nowrap fbw-option">Số lượng: </label>
                                        <input type="number" class="form-control ml-2" name="count" id="count" min="10"
                                            value="10" />
                                    </div>
                                    <div class="form-group d-flex align-items-center">
                                        <label for="price" class="text-nowrap fbw-option">Giá tiền: </label>
                                        <input type="number" class="form-control ml-2" name="price" id="price" />
                                    </div>
                                    <!-- <%- include('../components/discount_widget.ejs') %> -->
                                    <div class="form-group d-flex align-items-center">
                                        <label for="total" class="text-nowrap fbw-option">Tổng Giá: </label>
                                        <input type="text" class="form-control ml-2" name="total" id="total" disabled />
                                    </div>
                                    <div class="form-group d-flex align-items-center">
                                        <label for="note" class="text-nowrap fbw-option">Ghi chú: </label>
                                        <textarea class="form-control ml-2" name="note" id="note" rows="1"></textarea>
                                    </div>
                                    <br>
                                    <div class="form-group">
                                        <button id="submit" class="btnc-base btnc-success text-bold" type="submit">
                                            <i class="fa fa-shopping-cart"></i> Mua
                                        </button>
                                    </div>
                                    
                                    <div class="">
                                        <button class="btnc-base btnc-danger text-bold btn-view-history" type="button" data-target="#kt_history">
                                            <i class="fa fa-calendar"></i> Quản Lý ID
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <%- include('../components/note.ejs') %>
                    </div>
<script>
  var type = "<%= site.type %>";
</script>
