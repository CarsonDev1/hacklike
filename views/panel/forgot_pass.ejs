<!-- begin::Body -->

<body
        class="kt-offcanvas-panel--right kt-header--fixed kt-header-mobile--fixed kt-subheader--fixed kt-subheader--enabled kt-subheader--solid">

<!-- begin:: Page -->
<div class="kt-grid kt-grid--ver kt-grid--root">
    <div class="kt-grid kt-grid--hor kt-grid--root  kt-login kt-login--v4 kt-login--signin" id="kt_login">
        <div class="kt-grid__item kt-grid__item--fluid kt-grid kt-grid--hor has-background">
            <div class="kt-grid__item kt-grid__item--fluid kt-login__wrapper">
                <div class="kt-login__container">
                    <div class="kt-login__logo">
                        <a href="/">
                            <img src="/assets/images/logo.png" width="200px" alt="">
                        </a>
                    </div>
                    <div class="kt-login__signin">
                        <div class="kt-login__head">
                            <h3 class="kt-login__title">Khôi phục mật khẩu</h3>
                        </div>
                        <form id="emailForm" class="kt-form" action="<%= '/forgot_pass/create_code' %>">
                            <div class="input-group">
                                <input class="form-control" type="email" placeholder="Email của bạn" name="email"
                                       autocomplete="off"
                                       required maxlength="100">
                            </div>
                            <br>
                            <div class="kt-login__actions" style="margin-top: 3%">
                                <button type="submit" class="btn btn-brand btn-pill kt-login__btn-primary">Khôi phục mật
                                    khẩu
                                </button>
                            </div>

                            <p class="text-mail-alert">Gõ đúng Email. Thư nằm trong mục Thư quảng cáo hoặc Thứ Rác
                                (Spam).</p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!--begin::Modal-->
<div class="modal fade" id="modalChangePass" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <form id="passwordForm" action="<%= '/forgot_pass/confirm_code' %>">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Xác thực thông tin</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Mã OTP nhận được từ email</label>
                        <input class="form-control" name="code" minlength="5" maxlength="20" required/>
                    </div>

                    <div class="form-group">
                        <label>Mật khẩu mới</label>
                        <input class="form-control" type="text" placeholder="Mật khẩu" name="password"
                               required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Huỷ</button>
                    <button type="submit" class="btn btn-primary">Cập Nhật Mật Khẩu</button>
                </div>
            </div>
        </form>
    </div>
</div>
<!--end::Modal-->

<script src="/assets/plugins/jquery/jquery.min.js" type="text/javascript"></script>

