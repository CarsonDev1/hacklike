<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="/google/<%= site.type %>">
                                <div class="form-group">
                                    <label>Tên google maps</label>
                                    <input type="text" class="form-control" name="map_name"
                                           placeholder="Trùng với bảng hiệu" autocomplete="off" required
                                           maxlength="200">
                                </div>

                                <div class="form-group">
                                    <label>Chọn server</label>
                                    <div class="servers form-group">

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_1">Server 1 (Map ảo)
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_2">Server 2 (Map
                                                thật)
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Loại địa chỉ</label>

                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="location" value="vn" checked>
                                            Địa chỉ Việt Nam
                                        </label>
                                    </div>

                                    <div class="radio">
                                        <label>
                                            <input type="radio" name="location" value="global">
                                            Địa chỉ nước ngoài (Giá +300K)
                                        </label>
                                    </div>
                                </div>

                                <div class="form-group server-section server_2-visible">
                                    <div class="form-group">
                                        <label>Link Ảnh bảng hiệu + Ảnh trái + phải + trong cửa hàng
                                            <br/>
                                            (Website hỗ trợ get link ảnh: <a href="https://linkanh.xyz/"
                                                                             target="_blank">Tại Đây</a>)</label>
                                        <textarea class="form-control" name="map_image"
                                                  placeholder="Mỗi link ảnh 1 dòng" rows="5"></textarea>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="form-group">
                                        <label>Địa chỉ</label>
                                        <input class="form-control" name="map_address" required/>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="form-group">
                                        <label>SDT ghim trên google maps (Liên hệ fanpage để xác thực mã)</label>
                                        <input type="number" class="form-control" name="map_phone" required/>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="form-group">
                                        <label>Tên Website hoặc Fanpage (nếu có)</label>
                                        <input type="text" class="form-control" name="map_website"/>
                                    </div>
                                </div>

                                <div class="form-group server-section server_2-visible">
                                    <div class="form-group">
                                        <label>Thời gian hoạt động (vd 8h sáng -> 10h tối)</label>
                                        <textarea class="form-control" name="map_working_hour" rows="5"></textarea>
                                    </div>

                                    <div class="form-group">
                                        <label>SDT liên hệ nếu có vấn đề tạo lỗi hoặc thiếu thông tin</label>
                                        <input type="tel" class="form-control" name="contact_phone"/>
                                    </div>

                                    <div class="form-group">
                                        <label>Gmail (dùng để nhận quyền quản lý sau khi xong google maps)</label>
                                        <input type="email" class="form-control" name="map_email"/>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <input id="count" type="hidden" value="1"/>
                                    <label for="price">Giá tiền</label>
                                    <input type="number" class="form-control" name="price" id="price" disabled/>
                                </div>

                                <%- include('../components/discount_widget.ejs') %>

                                <div class="form-group">
                                    <label for="total">Tổng Giá</label>
                                    <input type="text" class="form-control" name="total" id="total" disabled/>
                                </div>

                                <div class="form-group">
                                    <label for="note">Ghi chú</label>
                                    <textarea class="form-control" name="note" id="note" rows="1"></textarea>
                                </div>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Mua</button>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_history">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý ID
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <%- include('../components/note.ejs') %>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="kt_history" role="tabpanel">
            <%- include('../components/status_filter.ejs') %>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-ajax"></table>
            </div>
        </div>
    </div>
</div>

<script>
    var type = "<%= site.type %>";
</script>

