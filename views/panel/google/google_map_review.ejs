<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="/google/<%= site.type %>">
                                <div class="form-group">
                                    <label>Link google maps</label>
                                    <input type="url" class="form-control" name="map_link"
                                           placeholder="https://www.google.com/maps/place/..." autocomplete="off"
                                           required maxlength="200">
                                </div>

                                <div class="form-group">
                                    <label>Chọn server</label>
                                    <div class="servers form-group">

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_1">Server 1
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_2">Server 2
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_3">Server 3
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group server-section server_1-visible server_2-visible">
                                    <label>Nhập nội dung Review (<span
                                                class="text-success content_count">0</span>)</label>
                                    <p class="text-danger">
                                        Các ngôn từ bị cấm: dm|đm|đ m|d m|địt mẹ|dit
                                        me|lol|lừađảo|conchó|trảtiền|mấtdạy|lừa đảo|
                                        con chó|trả tiền|mất dạy|lua dao|con cho|tra tien|mat day
                                    </p>
                                    <textarea type="number" class="form-control has_count" name="content" id="content"
                                              rows="10"
                                              data-counter=".content_count"
                                              placeholder="Mỗi Review 1 dòng, tối thiểu 5 dòng"
                                    ></textarea>
                                </div>

                                <div class="form-group server-section server_3-visible">
                                    <div class="form-group">
                                        <label>Số Lượng</label>
                                        <input type="number" class="form-control" id="count" name="count"/>
                                    </div>

                                    <div class="alert alert-primary mt-2">
                                        Người đánh giá sẽ tự nghĩ nội dung phù hợp để đánh giá với server này!
                                    </div>

                                    <div class="form-group">
                                        <label>Mô tả dịch vụ maps bạn cung cấp (bắt buộc với server này!)</label>
                                        <input class="form-control" name="description"/>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="price">Giá tiền</label>
                                    <input type="number" class="form-control" name="price" id="price" disabled/>
                                </div>

                                <%- include('../components/discount_widget.ejs') %>

                                <div class="form-group">
                                    <label for="total">Tổng Giá</label>
                                    <input type="text" class="form-control" name="total" id="total" disabled/>
                                </div>

                                <div class="form-group">
                                    <label for="note">Ghi chú</label>
                                    <textarea class="form-control" name="note" id="note" rows="1"></textarea>
                                </div>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Mua</button>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_history">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý ID
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <%- include('../components/note.ejs') %>
                </div>
            </div>
        </div>
        <div class="tab-pane" id="kt_history" role="tabpanel">
            <%- include('../components/status_filter.ejs') %>

            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-ajax"></table>
            </div>
        </div>
    </div>
</div>

<%- include('../components/modal_logs_plain') %>

<script>
    var type = "<%= site.type %>";
</script>

