<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="/view/<%= site.type %>">
                                <div class="form-group">
                                    <label for="uid">Link Video cần chạy</label>
                                    <input type="text" class="form-control" name="link"
                                           placeholder="Link Video cần chạy"
                                           autocomplete="off" required>
                                </div>

                                <div class="form-group">
                                    <label>Chọn server</label>

                                    <div class="servers">
                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_1">Server 1 (VIP)
                                                (Còn dư <span class="view_60k_live_v1_available"><span
                                                            class="fa fa-spinner fa-spin"></span></span> đơn)
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_2">Server 2 (Thường)
                                                (Còn dư <span class="view_60k_live_v2_available"><span
                                                            class="fa fa-spinner fa-spin"></span></span> đơn)
                                            </label>
                                        </div>

                                    </div>
                                </div>

                                <div class="form-group">
                                    <label>Độ dài video</label>
                                    <select class="form-control change-price" name="length_order">
                                        <option value="0" data-multiple="1">3 giờ (giá x1)</option>
                                        <option value="1" data-multiple="1.3">2 giờ (giá x1.3)</option>
                                        <option value="2" data-multiple="1.5">1 giờ (giá x1.5)</option>
                                    </select>

                                    <div class="mt-1 alert alert-warning">
                                        Độ dài video cần dư thêm tối thiểu 3s so với độ dài đã chọn. Ví dụ mua gói video
                                        2 giờ thì độ dài tối thiểu là 2 giờ 3 giây
                                    </div>
                                </div>

                                <%- include('../components/discount_widget.ejs') %>

                                <div class="form-group">
                                    <label for="total">Tổng Giá</label>
                                    <input type="text" class="form-control" name="total" id="total" value="" disabled/>
                                </div>

                                <div class="form-group">
                                    <label for="note">Ghi chú (tuỳ chọn)</label>
                                    <textarea class="form-control" name="note" id="note" rows="1"
                                              maxlength="255"></textarea>
                                </div>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Mua</button>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_history">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý ID
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <%- include('../components/note.ejs') %>
                </div>
            </div>

        </div>
        <div class="tab-pane" id="kt_history" role="tabpanel">
            <%- include('../components/status_filter.ejs') %>
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-ajax"></table>
            </div>
        </div>
    </div>
</div>

<script>
    var type = "<%= site.type %>";
</script>

