<% layout("panel/layout") %>

<%- include('../widget.ejs') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#kt_add" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Mua Dịch Vụ
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#kt_history" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i>Lịch Sử
            </a>
        </li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane active" id="kt_add" role="tabpanel">
            <div class="row">
                <div class="col-md-8">
                    <div class="card form-group">

                        <div class="card-body">
                            <form id="formUserAction" action="/view/<%= site.type %>">
                                <div class="form-group">
                                    <label for="uid">Link bài viết cần chạy (Hãy lấy đúng link videos)</label>
                                    <input type="text" class="form-control" id="url" name="url"
                                           placeholder="Link bài viết cần chạy"
                                           autocomplete="off" required>
                                </div>

                                <div class="form-group">
                                    <label>Chọn server</label>

                                    <div class="servers">
                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_3">Server 3
                                                (Còn dư <span class="view_live_vip"><span
                                                            class="fa fa-spinner fa-spin"></span></span> mắt)
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_2">Server 2
                                                (Còn dư <span class="view_live_normal"><span
                                                            class="fa fa-spinner fa-spin"></span></span> mắt)
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_1">Server 1
                                                (Còn dư <span class="view_live_cheap"><span
                                                            class="fa fa-spinner fa-spin"></span></span> mắt)
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_4">Server 4
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_5">Server 5
                                            </label>
                                        </div>

                                        <div class="radio radio-server">
                                            <label><input type="radio" name="server" value="server_6">Server 6
                                            </label>
                                        </div>

                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="count">
                                        Số lượng mắt
                                    </label>
                                    <input type="number" class="form-control change-price" name="count" min="20"
                                           value="50"/>

                                    <div class="server-section server_6-visible mt-1 alert alert-success">
                                        Lưu ý: Với server này nếu mua số lượng mắt < 50 thì vẫn tính giá của 50 mắt
                                    </div>
                                </div>

                                <div class="form-group server-section server_1-visible server_2-visible server_3-visible">
                                    <label>Kiểu xem</label>
                                    <select class="form-control" name="type_view">
                                        <option selected value="0">LIVE</option>
                                        <!-- <option value="1">RECOMMEND</option> -->
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label for="minutes">Phút xem</label>
                                    <input class="form-control change-price" type="number" name="minutes" value="30"
                                           min="30" max="600"/>

                                    <div class="server-section server_5-visible mt-1 alert alert-success">
                                        Server này chỉ hỗ trợ các giá trị Phút xem như sau: 30, 60, 90, 120, 150, 180,
                                        210, 240, 270, 300
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label for="price">Giá Tiền Mỗi Tương Tác</label>
                                    <input type="number" class="form-control" id="price" value="" disabled/>
                                </div>

                                <%- include('../components/discount_widget.ejs') %>

                                <div class="form-group">
                                    <label for="total">Tổng Giá</label>
                                    <input type="text" class="form-control" name="total" id="total" value="" disabled/>
                                </div>

                                <div class="form-group">
                                    <label for="note">Ghi chú (Không ghi cũng được)</label>
                                    <textarea class="form-control" name="note" id="note" rows="1"
                                              maxlength="255"></textarea>
                                </div>

                                <div class="form-group">
                                    <button id="submit" class="btn btn-success text-bold" type="submit">Mua</button>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-danger text-bold btn-view-history" type="button"
                                            data-target="#kt_history">
                                        <i class="fa fa-calendar" aria-hidden="true"></i> Quản Lý ID
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <%- include('../components/note.ejs') %>
                </div>
            </div>

        </div>
        <div class="tab-pane" id="kt_history" role="tabpanel">
            <%- include('../components/status_filter.ejs') %>
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="datatable-ajax"></table>
            </div>
        </div>
    </div>
</div>

<%- include('../components/modal_live_logs') %>

<script src="/assets/plugins/highchart/highcharts.min.js" type="text/javascript"></script>
<script src="/assets/js/js-live-logs.js?v=<%= version %>"></script>
<script>
    var type = "<%= site.type %>";
</script>

