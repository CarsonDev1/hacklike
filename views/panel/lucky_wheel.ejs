<% layout("panel/layout") %>

<style>
    .the_wheel {
        width: fit-content;
        border: 1px solid #00CC00;
        /*border-radius: 50%;*/
        padding: 10px;
        margin: 0 auto;
        position: relative;

        border-radius: 50%;
        /*background: url('/assets/images/tet_bg_2.png');*/
        /*background-size: cover;*/
    }

    .the_wheel #btn_spin {
        position: absolute;
        left: calc(50% - 37px);
        top: calc(50% - 37px);
        border-radius: 50%;
        color: white;
        background-color: orange;
        border: none;
        width: 75px;
        height: 75px;
        font-size: 20px;
        font-weight: bold;
        outline: none !important;
    }

    .the_wheel #spin_point {
        width: fit-content;
        position: absolute;
        top: -7px;
        left: calc(50% - 5px);
    }

    #the_wheel #canvas {
        max-width: 100%;
    }

    .wheel-rule {
        padding-left: 1rem;
    }

    .wheel-rule p {
        margin-bottom: 3px;
        color: cornflowerblue;
    }

    .prize-name {
        margin-bottom: 15px;
        font-size: 20px;
        font-weight: 600;
        color: chocolate;
    }

    .prize_image {
        width: 150px;
        margin-bottom: 10px;
    }

    .prize-note {
        font-size: 14px;
    }

    #swal2-title {
        margin-bottom: 0;
    }

    table td {
        font-size: 14px;
    }
</style>

<%- include('./widget') %>

<div class="content-container">
    <ul class="nav nav-tabs nav-tabs-line nav-tabs-line-danger nav-tabs-line-2x"
        role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-toggle="tab" href="#tab_1" role="tab" aria-selected="true">
                <i class="fas fa-cart-plus" aria-hidden="true"></i>Quay thưởng
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-toggle="tab" href="#tab_2" role="tab" aria-selected="false">
                <i class="fas fa-calendar-alt" aria-hidden="true"></i><span style="color:red">Lịch Sử</span>
            </a>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane active" id="tab_1" role="tabpanel">
            <div class="row">
                <div class="col-md-12">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="pull-left">
                                <h5>
                                    Số lượt quay:
                                    <span class="text-money" id="spin_count">0</span>
                                </h5>
                            </div>
                            <div class="pull-right">
                                <h5>
                                    Số dư tài khoản:
                                    <span class="text-money" id="user_balance">
                          <%= functions.number_format(account.price) %>
                        </span>
                                    ₫
                                </h5>
                            </div>
                        </div>
                    </div>

                    <hr>

                </div>

                <div class="col-md-12">
                    <div class="the_wheel" id="the_wheel">
                        <div id="spin_point">
                            <span class="fa fa-arrow-down"></span>
                        </div>
                        <button id="btn_spin">Quay</button>
                        <canvas id='canvas' width='500' height='500'>
                            Trình duyệt của bạn không được hỗ trợ, hãy đổi trình duyệt khác nhé ^^
                        </canvas>
                    </div>
                    <div id="loading_wheel" class="text-center">
                        <span class="fa fa-circle-o-notch fa-spin fa-5x fa-fw"></span>
                    </div>
                </div>

                <div class="col-md-12">
                    <hr/>
                    <h5>Thể lệ quay thưởng</h5>

                    <div class="wheel-rule">
                        <p>
                            <i class="fa fa-hand-o-right"></i>
                            Mỗi người có sẵn một lượt quay
                        </p>

                        <p>
                            <i class="fa fa-hand-o-right"></i>
                            Nếu có tranh chấp / lỗi xảy ra, quyết định của admin là quyết định cuối cùng
                        </p>
                    </div>
                </div>

                <div class="hidden" id="image_hidden"></div>
            </div>
        </div>
        <div class="tab-pane" id="tab_2" role="tabpanel">
            <table class="table table-bordered table-hover" id="datatable-lucky-wheel-history"></table>
        </div>
    </div>
</div>


<script src="/assets/plugins/winwheel/Winwheel.js"></script>
<script src="/assets/plugins/winwheel/TweenMax.min.js"></script>

<script src="/assets/js/datatable-lucky_wheel.js?v=<%= version %>"></script>
